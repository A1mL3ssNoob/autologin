#!/bin/sh /etc/rc.common
# procd 保持单个检测进程；正常在线安静，故障日志进入 logread。
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /root/autologin.py --watch --interval 10
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
